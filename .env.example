# MathStep Environment Template
# Copy this file to .env and fill in the placeholder values.

# Public Supabase configuration (safe to commit in example form)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
